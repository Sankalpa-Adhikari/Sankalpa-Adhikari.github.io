---
import Events from "@/components/events/events.astro";
import FieldNotes from "@/components/field-notes/field-notes.astro";
import Collections from "@/components/home/collections.astro";
import Hero from "@/components/home/hero.astro";
import ImageSlider from "@/components/home/image-slider.astro";
import Wrap from "@/components/home/wrap.astro";
import Research from "@/components/publications/research.astro";
import PageLayout from "@/layout/PageLayout.astro";
---

<PageLayout
  title="Saptabhumi Agro Research Center"
  description={"Description"}
  dataPagefindIgnore="all"
>
  <Hero />
  <Collections />
  <Wrap />
  <FieldNotes />
  <div class="flex flex-row">
    <div class="w-1/2">Hello world</div>
    <div class="px-4 sm:px-12 md:px-24 py-8 md:py-12 min-h-screen w-full">
      <ImageSlider visibleCount={4} spanFraction={1} />
    </div>
  </div>
  <Research />
  <Events />
</PageLayout>
