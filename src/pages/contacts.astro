---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layout/PageLayout.astro";
---

<PageLayout
  title="Contact Us | blueberrylabs Agro Research Center"
  description={"Get in touch with blueberrylabs for research partnerships, service inquiries, or to join our team."}
  dataPagefindIgnore="all"
>
  <section class="w-full overflow-hidden px-4 md:px-8 mt-24 mb-16 md:mb-24">
    <div
      class="flex flex-row flex-nowrap items-center justify-between mb-8 gap-10"
    >
      <div class="space-y-1">
        <h2 class="text-3xl md:text-6xl capitalize tracking-wide">
          Get in touch
        </h2>
        <p
          class="text-sm md:text-base text-black/70 normal-case leading-relaxed"
        >
          Whether you have a question about our research, want to partner on
          agricultural initiatives, or are interested in our premium
          agri-inputs, our team is ready to connect.
        </p>
      </div>
    </div>

    <div
      id="contact-info"
      class="grid grid-cols-1 md:grid-cols-12 gap-y-16 md:gap-x-8 lg:gap-x-12 border-t border-black/20 pt-12 md:pt-16"
    >
      <div class="md:col-span-5 lg:col-span-4 flex flex-col gap-12">
        <div class="space-y-3 group">
          <p
            class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-black/50"
          >
            Headquarters
          </p>
          <div>
            <h3 class="text-xl md:text-2xl capitalize tracking-wide mb-1">
              New Baneshowr
            </h3>
            <p class="text-sm text-black/70 leading-relaxed">
              Kathmandu, Nepal
            </p>
          </div>
          <a
            href="https://maps.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium border-b border-black/30 pb-0.5 hover:border-black transition-colors mt-2 w-fit"
          >
            Get Directions
            <Icon name="heroicons:arrow-up-right-20-solid" class="size-3.5" />
          </a>
        </div>

        <div class="space-y-8">
          <div class="space-y-3">
            <p
              class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-black/50"
            >
              General Inquiries
            </p>
            <a
              href="mailto:bblabs@gmail.com"
              class="block text-xl md:text-2xl tracking-wide hover:opacity-70 transition-opacity break-all"
            >
              bblabs@gmail.com
            </a>
          </div>

          <div class="space-y-3">
            <p
              class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-black/50"
            >
              Call Us
            </p>
            <a
              href="tel:+9779861588403"
              class="block text-xl md:text-2xl capitalize tracking-wide hover:opacity-70 transition-opacity font-mono"
            >
              +977 9861588403
            </a>
            <a
              href="tel:+9779818296997"
              class="block text-xl md:text-2xl capitalize tracking-wide hover:opacity-70 transition-opacity font-mono"
            >
              +977 9818296997
            </a>
          </div>
        </div>
      </div>

      <div class="md:col-span-7 lg:col-span-7 lg:col-start-6">
        <form class="flex flex-col gap-8 md:gap-10">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
            <div class="relative flex flex-col gap-2 group">
              <label
                for="firstName"
                class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-black/60 transition-colors group-focus-within:text-black"
              >
                First Name
              </label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                class="w-full bg-transparent border-b border-black/20 py-2 px-0 text-base outline-none transition-colors focus:border-black rounded-none"
                placeholder="Jane"
              />
            </div>

            <div class="relative flex flex-col gap-2 group">
              <label
                for="lastName"
                class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-black/60 transition-colors group-focus-within:text-black"
              >
                Last Name
              </label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                class="w-full bg-transparent border-b border-black/20 py-2 px-0 text-base outline-none transition-colors focus:border-black rounded-none"
                placeholder="Doe"
              />
            </div>
          </div>

          <div class="relative flex flex-col gap-2 group">
            <label
              for="email"
              class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-black/60 transition-colors group-focus-within:text-black"
            >
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-transparent border-b border-black/20 py-2 px-0 text-base outline-none transition-colors focus:border-black rounded-none"
              placeholder="jane@example.com"
            />
          </div>

          <div class="relative flex flex-col gap-2 group">
            <label
              for="subject"
              class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-black/60 transition-colors group-focus-within:text-black"
            >
              Subject
            </label>
            <select
              id="subject"
              name="subject"
              class="w-full bg-transparent border-b border-black/20 py-2 px-0 text-base outline-none transition-colors focus:border-black rounded-none appearance-none cursor-pointer"
            >
              <option value="" disabled selected>Select a topic...</option>
              <option value="services"
                >Agricultural Services & Consulting</option
              >
              <option value="research">Research Partnerships</option>
              <option value="trade">Product Trade & Supply Chain</option>
              <option value="careers">Careers & Pitch</option>
              <option value="other">Other Inquiry</option>
            </select>
            <Icon
              name="heroicons:chevron-down-20-solid"
              class="absolute right-0 bottom-3 size-5 text-black/40 pointer-events-none"
            />
          </div>

          <div class="relative flex flex-col gap-2 group">
            <label
              for="message"
              class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-black/60 transition-colors group-focus-within:text-black"
            >
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="w-full bg-transparent border-b border-black/20 py-2 px-0 text-base outline-none transition-colors focus:border-black rounded-none resize-none"
              placeholder="Tell us about your project or inquiry..."></textarea>
          </div>

          <div class="pt-4">
            <button
              type="submit"
              class="group cursor-pointer inline-flex items-center gap-3 rounded-full bg-primary py-1.5 pl-5 pr-1.5 text-base text-black w-fit transition-transform hover:scale-[1.02] active:scale-95"
            >
              <span class="font-medium">Send Message</span>
              <span
                class="flex size-8 items-center justify-center rounded-full bg-white text-black transition-colors duration-300 group-hover:bg-black group-hover:text-white"
              >
                <Icon class="size-5" name="heroicons:arrow-up-right-20-solid" />
              </span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</PageLayout>
