---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import FieldNotesDialog from "@/components/field-notes/field-notes-dialog.astro";
import PageLayout from "@/layout/PageLayout.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const FieldNotesEntries = await getCollection("fieldNotes");

  return paginate(FieldNotesEntries, {
    pageSize: 10,
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"fieldNotes">>;
}

const { page } = Astro.props;
---

<PageLayout
  title="blueberrylabs | Field Notes"
  description={"Description"}
  dataPagefindIgnore="all"
>
  <field-notes-grid>
    <section class="w-full overflow-hidden px-4 mt-28">
      <div class="flex flex-row flex-nowrap items-center justify-between">
        <div class="space-y-1">
          <h2 class="text-3xl md:text-6xl capitalize tracking-wide">
            Field Notes
          </h2>
          <p
            class="text-sm md:text-base text-black/80 lg:max-w-lg normal-case leading-relaxed"
          >
            Insights, experiments, and ongoing thoughts from our research
            process.
          </p>
        </div>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-8 smt-12 w-full"
      >
        {
          page.data.map((entry, index) => {
            const slide = entry.data;
            return (
              <article
                data-field-note-card
                data-index={index}
                data-title={slide.title}
                data-date={slide.date}
                data-desc={slide.desc}
                data-embed={slide.embedUrl}
                class="w-full group relative flex flex-col gap-4 cursor-pointer select-none"
              >
                <div class="relative w-full aspect-4/5 overflow-hidden rounded-md bg-background/5 transition-transform duration-500 ease-out group-hover:scale-[0.97]">
                  <Image
                    inferSize
                    referrerpolicy="no-referrer"
                    src={slide.image}
                    alt={slide.title}
                    draggable="false"
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 pointer-events-none select-none"
                    loading="lazy"
                  />

                  <div class="absolute bottom-4 left-4 flex size-8 items-center justify-center rounded-full bg-background/40 text-white transition-colors duration-300 group-hover:bg-primary group-hover:text-black z-10 shadow-sm pointer-events-none">
                    <Icon name="heroicons:play-solid" class="size-4 ml-1" />
                  </div>
                </div>

                <div class="flex flex-col gap-2 px-1 pointer-events-none">
                  <div class="flex justify-between items-start uppercase tracking-widest text-xs">
                    <span class="text-black/50 font-mono">{slide.num}</span>
                    <span class="text-black/50 font-mono">{slide.date}</span>
                  </div>

                  <div class="space-y-1">
                    <h3 class="text-xl uppercase tracking-wide font-medium leading-snug truncate">
                      {slide.title}
                    </h3>
                    <p class="text-xs text-black/60 normal-case leading-relaxed line-clamp-2">
                      {slide.desc}
                    </p>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <FieldNotesDialog />
    </section>
  </field-notes-grid>

  <nav
    aria-label="Pagination"
    class="mt-16 px-4 flex items-center justify-between pb-12"
  >
    <div class="flex w-0 flex-1">
      {
        page.url.prev && (
          <a
            href={page.url.prev}
            class="group inline-flex items-center gap-2 rounded-full border border-black/20 bg-transparent px-5 py-2.5 text-sm font-medium text-black transition-all hover:bg-black hover:text-white"
          >
            <Icon
              name="heroicons:arrow-small-left-20-solid"
              class="size-5 transition-transform group-hover:-translate-x-1"
            />
            Previous
          </a>
        )
      }
    </div>

    <div class="flex w-0 flex-1 justify-end">
      {
        page.url.next && (
          <a
            href={page.url.next}
            class="group inline-flex items-center gap-2 rounded-full border border-black/20 bg-transparent px-5 py-2.5 text-sm font-medium text-black transition-all hover:bg-black hover:text-white"
          >
            Next
            <Icon
              name="heroicons:arrow-small-right-20-solid"
              class="size-5 transition-transform group-hover:translate-x-1"
            />
          </a>
        )
      }
    </div>
  </nav>
</PageLayout>

<script>
  class FieldNotesGrid extends HTMLElement {
    private cards: NodeListOf<HTMLElement> | null = null;
    private dialogEl: HTMLElement | null = null;
    private dialogIframe: HTMLIFrameElement | null = null;
    private dialogTitle: HTMLElement | null = null;
    private dialogDate: HTMLElement | null = null;
    private dialogDesc: HTMLElement | null = null;
    private dialogClose: HTMLButtonElement | null = null;
    private dialogBackdrop: HTMLElement | null = null;

    constructor() {
      super();
      this.handleKeydown = this.handleKeydown.bind(this);
      this.closeDialog = this.closeDialog.bind(this);
      this.handleCardClick = this.handleCardClick.bind(this);
    }

    connectedCallback() {
      this.cards = this.querySelectorAll<HTMLElement>("[data-field-note-card]");

      this.dialogEl = this.querySelector<HTMLElement>("#field-notes-dialog");
      this.dialogIframe =
        this.querySelector<HTMLIFrameElement>("#dialog-iframe");
      this.dialogTitle = this.querySelector<HTMLElement>("#dialog-title");
      this.dialogDate = this.querySelector<HTMLElement>("#dialog-date");
      this.dialogDesc = this.querySelector<HTMLElement>("#dialog-desc");
      this.dialogClose = this.querySelector<HTMLButtonElement>("#dialog-close");
      this.dialogBackdrop = this.querySelector<HTMLElement>("#dialog-backdrop");

      this.dialogClose?.addEventListener("click", this.closeDialog);
      this.dialogBackdrop?.addEventListener("click", this.closeDialog);
      window.addEventListener("keydown", this.handleKeydown);

      this.cards?.forEach((card) =>
        card.addEventListener("click", this.handleCardClick),
      );
    }

    disconnectedCallback() {
      this.dialogClose?.removeEventListener("click", this.closeDialog);
      this.dialogBackdrop?.removeEventListener("click", this.closeDialog);
      window.removeEventListener("keydown", this.handleKeydown);

      this.cards?.forEach((card) =>
        card.removeEventListener("click", this.handleCardClick),
      );
    }

    handleCardClick(e: MouseEvent) {
      const card = e.currentTarget as HTMLElement;
      const { title, date, desc, embed } = card.dataset;

      if (this.dialogIframe) this.dialogIframe.src = embed || "";
      if (this.dialogTitle) this.dialogTitle.textContent = title || "";
      if (this.dialogDate) this.dialogDate.textContent = date || "";
      if (this.dialogDesc) this.dialogDesc.textContent = desc || "";

      this.dialogEl?.classList.remove("hidden");
      this.dialogEl?.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    closeDialog() {
      this.dialogEl?.classList.add("hidden");
      this.dialogEl?.classList.remove("flex");
      if (this.dialogIframe) this.dialogIframe.src = "";
      document.body.style.overflow = "";
    }

    handleKeydown(e: KeyboardEvent) {
      if (e.key === "Escape" && !this.dialogEl?.classList.contains("hidden")) {
        this.closeDialog();
      }
    }
  }

  customElements.define("field-notes-grid", FieldNotesGrid);
</script>
