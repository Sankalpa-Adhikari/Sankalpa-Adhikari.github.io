---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import Events from "@/components/events/events.astro";
import PageLayout from "@/layout/PageLayout.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const eventsEntries = await getCollection("events");

  return paginate(eventsEntries, {
    pageSize: 2,
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"events">>;
}

const { page } = Astro.props;
---

<PageLayout
  title="blueberrylabs | Events"
  description={"Description"}
  dataPagefindIgnore="all"
>
  <section class="w-full overflow-hidden px-4 mt-28">
    <div class="flex flex-row flex-nowrap items-center justify-between mb-6">
      <div class="space-y-1">
        <h2 class="text-3xl md:text-6xl capitalize tracking-wide">Events</h2>
        <p
          class="text-sm md:text-base text-black/80 lg:max-w-lg normal-case leading-relaxed"
        >
          Insights, experiments, and ongoing thoughts from our research process.
        </p>
      </div>
    </div>
    <div class="flex flex-col w-full">
      {
        page.data.map((item) => (
          <Events event={{ ...item.data, href: `/events/${item.id}` }} />
        ))
      }
    </div>
  </section>

  <nav
    aria-label="Pagination"
    class="mt-12 px-4 flex items-center justify-between"
  >
    <div class="flex w-0 flex-1">
      {
        page.url.prev && (
          <a
            href={page.url.prev}
            class="group inline-flex items-center gap-2 rounded-full border border-black/20 bg-transparent px-5 py-2.5 text-sm font-medium text-black transition-all hover:bg-black hover:text-white"
          >
            <Icon
              name="heroicons:arrow-small-left-20-solid"
              class="size-5 transition-transform group-hover:-translate-x-1"
            />
            Previous
          </a>
        )
      }
    </div>

    <div class="flex w-0 flex-1 justify-end">
      {
        page.url.next && (
          <a
            href={page.url.next}
            class="group inline-flex items-center gap-2 rounded-full border border-black/20 bg-transparent px-5 py-2.5 text-sm font-medium text-black transition-all hover:bg-black hover:text-white"
          >
            Next
            <Icon
              name="heroicons:arrow-small-right-20-solid"
              class="size-5 transition-transform group-hover:translate-x-1"
            />
          </a>
        )
      }
    </div>
  </nav>
</PageLayout>
