---
import { Image } from "astro:assets";

export type ImageItem =
  | string
  | {
      src: string;
      href?: string;
      date?: string;
      title?: string;
      subtitle?: string;
    };

interface Props {
  /** custom image list. Accepts an array of strings or objects with `src` and `href`. */
  images: ImageItem[];
  /** How many cards are visible (fully opaque) at once. Default 4. */
  visibleCount?: number;
  /** Milliseconds between each auto-advance. Default 2000. */
  intervalMs?: number;
  /** How much of a card gets tucked under the next one, 0-1. Default 0.5. */
  overlap?: number;
  /** How much of the container's width the whole stack should span, 0-1. Default 0.94. */
  spanFraction?: number;
  /** Enables a slight dimming/backdrop effect when a card is hovered. Default false. */
  dimOnHover?: boolean;
}

const {
  visibleCount = 2,
  intervalMs = 2000,
  images,
  overlap = 0.5,
  spanFraction = 0.94,
  dimOnHover = false,
} = Astro.props;

const normalizedImages = images.map((img) =>
  typeof img === "string" ? { src: img } : img,
);

const hasImages = normalizedImages.length > 0;
const totalImages = hasImages
  ? Math.max(normalizedImages.length, visibleCount + 4)
  : 0;
const loopImages = hasImages
  ? Array.from(
      { length: totalImages },
      (_, i) => normalizedImages[i % normalizedImages.length],
    )
  : [];
---

{
  hasImages && (
    <div class="relative flex w-full items-center">
      <div class="gallery-viewport rounded-calc relative flex h-[70vw] sm:h-[50vw] md:h-[35vw] w-full items-center overflow-clip">
        {loopImages.map((item, index) => {
          const Element = item.href ? "a" : "div";
          const slideNum = String(index + 1).padStart(2, "0");

          return (
            <Element
              href={item.href}
              class="gallery-card group absolute top-1/2 block overflow-clip rounded-[12px] origin-center opacity-0 text-[2vw] md:text-[1vw]"
              data-index={index}
              data-cursor
              data-cursor-view
              data-cursor-text="View"
            >
              <Image
                src={item.src}
                alt={item.title || `Slide ${index}`}
                width={1200}
                height={800}
                class="gallery-img size-full object-cover"
              />

              {/* Text Overlay: Hidden by default, visible on hover, z-30 ensures it stays above the dim layer */}
              <div class="absolute inset-0 z-30 flex flex-col justify-between p-[1.25em] pointer-events-none opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                <div class="flex w-full justify-between items-start">
                  <span class="text-white font-mono text-[1em] drop-shadow-md">
                    {slideNum}
                  </span>
                  {item.date && (
                    <span class="text-white font-mono text-[1em] drop-shadow-md">
                      {item.date}
                    </span>
                  )}
                </div>

                {(item.title || item.subtitle) && (
                  <div class="space-y-[0.25em] text-white drop-shadow-md">
                    {item.title && (
                      <h3 class="text-[1.25em] uppercase tracking-wide font-medium leading-snug truncate">
                        {item.title}
                      </h3>
                    )}
                    {item.subtitle && (
                      <p class="text-[0.75em] normal-case leading-relaxed line-clamp-2">
                        {item.subtitle}
                      </p>
                    )}
                  </div>
                )}
              </div>

              {/* Hover Overlay */}
              {dimOnHover && (
                <div class="absolute inset-0 z-20 bg-black/30 opacity-0 transition-opacity duration-300 pointer-events-none group-hover:opacity-100" />
              )}
            </Element>
          );
        })}
      </div>
    </div>
  )
}

<script define:vars={{ visibleCount, intervalMs, overlap, spanFraction }}>
  let galleryIntervalId;

  function initImageGallery() {
    const viewport = document.querySelector(".gallery-viewport");
    const cards = document.querySelectorAll(".gallery-card");
    if (!viewport || !cards.length) return;

    const totalCards = cards.length;
    const N = Math.max(1, Math.min(visibleCount, totalCards));
    let currentIndex = 0;

    const easing = "cubic-bezier(0.76,0,0.24,1)";
    const duration = 800;

    const SIZE_RATIO = 0.49;

    const t = (i) => (N === 1 ? 1 : (i - 1) / (N - 1));

    const computeGeometry = () => {
      const heights = [];
      for (let i = 1; i <= N; i++) {
        heights.push(SIZE_RATIO + t(i) * (1 - SIZE_RATIO));
      }

      const rawWidths = [];
      for (let i = 1; i <= N; i++) {
        rawWidths.push(SIZE_RATIO + t(i) * (1 - SIZE_RATIO));
      }
      let rawSpan = rawWidths[N - 1];
      for (let i = 0; i < N - 1; i++) rawSpan += rawWidths[i] * overlap;
      const scale = rawSpan > 0 ? spanFraction / rawSpan : 0;
      const widths = rawWidths.map((w) => w * scale);

      const margin = (1 - spanFraction) / 2;
      const lefts = new Array(N);
      lefts[N - 1] = 1 - margin - widths[N - 1];
      for (let i = N - 2; i >= 0; i--) {
        lefts[i] = lefts[i + 1] - widths[i] * (1 - overlap);
      }

      return { widths, heights, lefts };
    };

    const pct = (f) => `${f * 100}%`;

    const updateGalleryPositions = () => {
      const { widths, heights, lefts } = computeGeometry();

      cards.forEach((card, i) => {
        const img = card.querySelector(".gallery-img");
        let pos = (i - currentIndex) % totalCards;
        if (pos < 0) pos += totalCards;

        img.style.transition = `transform ${duration}ms ${easing}`;

        if (pos === 0) {
          card.style.transition = `all ${duration}ms ${easing}`;
          Object.assign(card.style, {
            left: pct(lefts[0]),
            width: pct(widths[0]),
            height: pct(heights[0]),
            zIndex: "0",
            opacity: "0",
            transform: "translateY(-50%) translateX(20px) scale(0.5)",
          });
          img.style.transform = "scale(1)";
        } else if (pos >= 1 && pos <= N) {
          card.style.transition = `all ${duration}ms ${easing}`;
          Object.assign(card.style, {
            left: pct(lefts[pos - 1]),
            width: pct(widths[pos - 1]),
            height: pct(heights[pos - 1]),
            zIndex: String(10 * pos),
            opacity: "1",
            transform: "translateY(-50%)",
          });
          img.style.transform = "scale(1)";
        } else if (pos === N + 1) {
          card.style.transition = `all ${duration}ms ${easing}`;
          Object.assign(card.style, {
            left: "100%",
            width: pct(widths[N - 1]),
            height: pct(heights[N - 1]),
            zIndex: String(10 * (N + 1)),
            opacity: "0",
            transform: "translateY(-50%)",
          });
          img.style.transform = "scale(1.5)";
        } else {
          card.style.transition = "none";
          Object.assign(card.style, {
            left: "100%",
            width: pct(widths[N - 1]),
            height: pct(heights[N - 1]),
            zIndex: "-1",
            opacity: "0",
            transform: "translateY(-50%)",
          });
          img.style.transform = "scale(1.5)";
        }
      });
    };

    updateGalleryPositions();

    if (galleryIntervalId) clearInterval(galleryIntervalId);
    galleryIntervalId = setInterval(() => {
      currentIndex++;
      updateGalleryPositions();
    }, intervalMs);
  }

  document.addEventListener("astro:page-load", initImageGallery);
  if (!document.startViewTransition) initImageGallery();
</script>
