---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Logo from "@/assets/images/logo.png";
import MobileNavDrawer from "./mobile-nav-drawer.astro";
---

<header class="fixed top-4 left-4 right-4 z-5000">
  <nav
    class="relative z-10 flex h-16 w-full items-center justify-between text-sm font-medium tracking-wide text-foreground uppercase"
  >
    <div class="absolute inset-0 z-[-1] flex justify-end">
      <div
        id="nav-bg"
        class="h-full w-full rounded-2xl bg-background shadow-md"
      >
      </div>
    </div>

    <a
      href="/"
      class="relative flex h-full shrink-0 items-center pl-3 pr-1 sm:pl-4 sm:pr-2"
    >
      <Image src={Logo} alt="Logo" class="h-4 w-auto object-contain sm:h-5" />
    </a>

    <div
      id="nav-links-container"
      class="hidden sm:overflow-hidden sm:block whitespace-nowrap"
    >
      <div class="group flex items-center gap-8 px-4">
        <a
          href="/publications"
          class="nav-link group/link relative inline-flex overflow-hidden transition-all duration-300 group-has-[a:hover]:opacity-40 hover:!opacity-100"
        >
          <span
            class="block transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/link:-translate-y-full"
          >
            Publications
          </span>
          <span
            aria-hidden="true"
            class="absolute left-0 top-full block transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/link:-translate-y-full"
          >
            Publications
          </span>
        </a>

        <a
          href="/events"
          class="nav-link group/link relative inline-flex overflow-hidden transition-all duration-300 group-has-[a:hover]:opacity-40 hover:!opacity-100"
        >
          <span
            class="block transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/link:-translate-y-full"
          >
            Events
          </span>
          <span
            aria-hidden="true"
            class="absolute left-0 top-full block transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/link:-translate-y-full"
          >
            Events
          </span>
        </a>

        <a
          href="/careers"
          class="nav-link group/link relative inline-flex overflow-hidden transition-all duration-300 group-has-[a:hover]:opacity-40 hover:!opacity-100"
        >
          <span
            class="block transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/link:-translate-y-full"
          >
            Careers
          </span>
          <span
            aria-hidden="true"
            class="absolute left-0 top-full block transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/link:-translate-y-full"
          >
            Careers
          </span>
        </a>
      </div>
    </div>

    <div
      id="right-container"
      class="relative flex h-full shrink-0 items-center pl-3 pr-4"
    >
      <a
        href="/contacts"
        class="group hidden sm:inline-flex items-center gap-3 rounded-full bg-primary py-1.5 pl-5 pr-1.5 text-sm font-semibold text-black transition-all hover:brightness-110"
      >
        <span>Contact</span>
        <span
          class="flex size-8 items-center justify-center rounded-full bg-white text-black transition-transform group-hover:translate-x-0.5"
        >
          <Icon class="size-5" name="heroicons:arrow-small-right-20-solid" />
        </span>
      </a>

      <div
        id="menu-btn-container"
        class="flex w-12 shrink-0 justify-end overflow-hidden sm:w-0 sm:opacity-0"
      >
        <div class="sm:pl-2">
          <button
            id="menu-toggle-btn"
            aria-label="Toggle menu"
            class="flex w-10 shrink-0 cursor-pointer flex-col items-center justify-center gap-1.5 p-2"
          >
            <span id="line-1" class="block h-0.5 w-6 rounded-full bg-foreground"
            ></span>
            <span id="line-2" class="block h-0.5 w-6 rounded-full bg-foreground"
            ></span>
            <span id="line-3" class="block h-0.5 w-6 rounded-full bg-foreground"
            ></span>
          </button>
        </div>
      </div>
    </div>
  </nav>
  <MobileNavDrawer />
</header>

<script>
  import { gsap } from "@/utils/gsap-init";
  import { isMobileNavOpen, toggleMobileNav } from "@/utils/atoms/nav-store";

  let ctx: gsap.Context;

  function initHeaderAnimation() {
    const linksContainer = document.querySelector("#nav-links-container");
    const menuContainer = document.querySelector("#menu-btn-container");
    const navBg = document.querySelector("#nav-bg");
    const rightContainer = document.querySelector("#right-container");
    const menuBtn = document.querySelector("#menu-toggle-btn");
    const line1 = document.querySelector("#line-1");
    const line2 = document.querySelector("#line-2");
    const line3 = document.querySelector("#line-3");

    if (
      !linksContainer ||
      !menuContainer ||
      !navBg ||
      !rightContainer ||
      !menuBtn
    )
      return;

    ctx = gsap.context(() => {
      let isThrottled = false;
      menuBtn.addEventListener("click", () => {
        if (isThrottled) return;
        isThrottled = true;
        toggleMobileNav();
        setTimeout(() => (isThrottled = false), 500);
      });

      const unsubscribe = isMobileNavOpen.subscribe((isOpen) => {
        if (isOpen) {
          gsap.to(line1, {
            y: 8,
            rotate: 45,
            transformOrigin: "center center",
            duration: 0.4,
            ease: "back.out(1.5)",
          });
          gsap.to(line2, {
            scaleX: 0,
            opacity: 0,
            duration: 0.2,
            ease: "power2.inOut",
          });
          gsap.to(line3, {
            y: -8,
            rotate: -45,
            transformOrigin: "center center",
            duration: 0.4,
            ease: "back.out(1.5)",
          });
        } else {
          gsap.to(line1, {
            y: 0,
            rotate: 0,
            duration: 0.4,
            ease: "power3.out",
          });
          gsap.to(line2, {
            scaleX: 1,
            opacity: 1,
            duration: 0.4,
            ease: "power3.out",
          });
          gsap.to(line3, {
            y: 0,
            rotate: 0,
            duration: 0.4,
            ease: "power3.out",
          });
        }
      });

      let mm = gsap.matchMedia();

      mm.add("(min-width: 641px)", () => {
        gsap.set(linksContainer, { width: 0 });
        gsap.set([menuContainer], { width: 48 });

        const targetBgWidth = rightContainer.getBoundingClientRect().width;

        gsap.set(linksContainer, { width: "auto", opacity: 1 });
        gsap.set([menuContainer], { width: 0, opacity: 0 });
        gsap.set(navBg, { width: "100%" });

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: document.body,
            start: "50px top",
            toggleActions: "play none none reverse",
          },
          defaults: {
            duration: 0.4,
            ease: "power2.inOut",
          },
        });

        tl.to(linksContainer, { width: 0, opacity: 0 }, 0)
          .to([menuContainer], { width: 48, opacity: 1 }, 0)
          .to(navBg, { width: targetBgWidth }, 0);
      });

      return () => unsubscribe();
    });
  }

  document.addEventListener("astro:page-load", initHeaderAnimation);

  document.addEventListener("astro:before-swap", () => {
    ctx && ctx.revert();
  });
</script>
