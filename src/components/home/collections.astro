---

<section
  class="relative w-full bg-neutral-900"
  data-component="collections-pinned"
>
  <div class="relative h-screen w-full overflow-hidden" data-pin-wrapper>
    <div
      class="pointer-events-none absolute left-0 top-1/2 z-100 h-px w-full -translate-y-1/2 bg-white/20"
    >
      <div
        class="h-full w-full origin-left bg-white will-change-transform"
        data-progress-bar
        style="transform: scaleX(0);"
      >
      </div>
    </div>

    {
      collections.map((item, i) => (
        <div
          class="absolute inset-0 flex h-full w-full items-center justify-center overflow-hidden will-change-[clip-path]"
          data-collection-item
          style={{ zIndex: i + 1 }}
        >
          <div class="absolute inset-0 z-0 h-full w-full">
            <Image
              src={item.media[0]}
              alt={item.title}
              width={1920}
              height={1080}
              class="h-full w-full object-cover will-change-transform"
              data-media-inner
            />
            <div class="absolute inset-0 bg-black/50" />
          </div>

          <div class="pointer-events-none absolute left-6 right-6 md:left-12 md:right-12 top-1/2 z-40 flex w-auto justify-between h-px -translate-y-1/2">
            <div class="relative flex flex-col">
              <span class="absolute bottom-3 left-0 text-xs md:text-sm font-light text-white leading-none">
                {item.index}
              </span>
              <span class="absolute top-3 left-0 whitespace-nowrap text-xs md:text-sm tracking-widest text-white uppercase">
                Saptabhumi
              </span>
            </div>

            <div class="relative flex flex-col items-end">
              <span class="absolute bottom-3 right-0 whitespace-nowrap rounded-full bg-primary px-3 py-1 text-xs font-medium uppercase tracking-wider text-black">
                {item.tag}
              </span>
            </div>
          </div>

          <div class="pointer-events-none absolute bottom-1/2 left-0 z-20 flex w-full justify-center px-6 pb-8 text-center md:px-12">
            <h3 class="pointer-events-auto max-w-5xl text-3xl font-medium tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl">
              {item.title}
            </h3>
          </div>

          <div class="pointer-events-none absolute top-1/2 left-0 z-20 flex w-full justify-center px-6 pt-8 text-center md:px-12">
            <a
              href={item.link}
              class="group pointer-events-auto inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 py-1.5 pl-5 pr-1.5 text-sm text-white backdrop-blur-md transition-all hover:bg-white hover:text-black"
            >
              <span>See {item.tag} Products</span>
              <span class="flex size-8 items-center justify-center rounded-full bg-white text-black transition-transform group-hover:bg-black group-hover:text-white">
                <Icon
                  class="size-5"
                  name="heroicons:arrow-small-right-20-solid"
                />
              </span>
            </a>
          </div>

          <div
            class="collection-card pointer-events-auto absolute bottom-6 right-6 md:bottom-12 md:right-12 z-30 w-[calc(100%-3rem)] max-w-xs md:max-w-sm rounded-2xl border border-white/15 bg-neutral-950/60 p-5 backdrop-blur-xl shadow-2xl transition-all"
            data-card
          >
            <div
              class="flex items-center justify-between border-b border-white/10 pb-3"
              data-card-item
            >
              <div class="flex items-center gap-2">
                <span class="inline-block size-2 rounded-full bg-emerald-400 animate-pulse" />
                <span class="text-xs font-semibold tracking-wider text-white/90 uppercase">
                  Service Overview
                </span>
              </div>
              <span class="text-xs font-mono text-white/50">
                {item.index} / 08
              </span>
            </div>

            {/* Metrics Grid */}
            <div class="grid grid-cols-2 gap-3 py-3" data-card-item>
              {item.stats.map((stat) => (
                <div class="rounded-lg bg-white/5 p-2.5 border border-white/5">
                  <span class="block text-[10px] uppercase tracking-wider text-white/50 font-medium">
                    {stat.label}
                  </span>
                  <span class="text-sm font-semibold text-white mt-0.5 block">
                    {stat.value}
                  </span>
                </div>
              ))}
            </div>

            {/* Highlights List */}
            <div
              class="space-y-1.5 border-t border-white/10 pt-3"
              data-card-item
            >
              {item.highlights.map((highlight) => (
                <div class="flex items-center gap-2 text-xs text-white/80">
                  <Icon
                    name="heroicons:check-circle-20-solid"
                    class="size-4 text-emerald-400 shrink-0"
                  />
                  <span>{highlight}</span>
                </div>
              ))}
            </div>

            {/* Secondary Media Preview Thumbnail */}
            {item.media[1] && (
              <div
                class="mt-3 overflow-hidden rounded-lg border border-white/10 h-16 relative group cursor-pointer"
                data-card-item
              >
                <img
                  src={item.media[1]}
                  alt={`${item.tag} gallery`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <span class="text-[10px] uppercase font-bold tracking-widest text-white">
                    View Gallery
                  </span>
                </div>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "@/utils/gsap-init";

  let ctx: gsap.Context | undefined;

  function initPinnedCollections() {
    if (ctx) ctx.revert();

    const section = document.querySelector<HTMLElement>(
      '[data-component="collections-pinned"]',
    );
    if (!section) return;

    const pinWrapper = section.querySelector<HTMLElement>("[data-pin-wrapper]");
    const items = gsap.utils.toArray("[data-collection-item]") as HTMLElement[];
    const progressBar = section.querySelector<HTMLElement>(
      "[data-progress-bar]",
    );

    if (!pinWrapper || items.length < 2) return;

    ctx = gsap.context(() => {
      items.forEach((item, i) => {
        const mediaInner = item.querySelector("[data-media-inner]");

        if (i === 0) {
          gsap.set(item, { clipPath: "inset(0% 0% 0% 0%)" });
          if (mediaInner) gsap.set(mediaInner, { scale: 1, yPercent: 0 });
        } else {
          gsap.set(item, { clipPath: "inset(100% 0% 0% 0%)" });
          if (mediaInner) gsap.set(mediaInner, { scale: 1.15, yPercent: 8 });
        }
      });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: `+=${items.length * 100}%`,
          pin: pinWrapper,
          pinSpacing: true,
          anticipatePin: 1,
          scrub: 0.5,
          refreshPriority: 1,
        },
      });

      items.forEach((item, i) => {
        if (i === 0) return;

        const mediaInner = item.querySelector("[data-media-inner]");

        const positionOffset = i === 1 ? undefined : "-=0.25";

        tl.to(
          item,
          { clipPath: "inset(0% 0% 0% 0%)", duration: 1, ease: "none" },
          positionOffset,
        );

        if (mediaInner) {
          tl.to(
            mediaInner,
            { scale: 1, yPercent: 0, duration: 1, ease: "none" },
            "<",
          );
        }
      });

      if (progressBar) {
        tl.to(
          progressBar,
          { scaleX: 1, duration: tl.duration(), ease: "none" },
          0,
        );
      }
    }, section);
  }

  function setupAnimation() {
    const images = document.querySelectorAll<HTMLImageElement>(
      '[data-component="collections-pinned"] img',
    );

    const imagePromises = Array.from(images).map((img) => {
      if (img.complete) return Promise.resolve();
      return new Promise((resolve) => {
        img.addEventListener("load", resolve, { once: true });
        img.addEventListener("error", resolve, { once: true });
      });
    });

    Promise.all(imagePromises).then(() => {
      initPinnedCollections();
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
    });
  }

  document.addEventListener("astro:page-load", setupAnimation);
  document.addEventListener("astro:before-swap", () => {
    if (ctx) ctx.revert();
  });
</script>
