---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<section
  id="hero-container"
  class="relative h-[400vh] bg-neutral-950 text-white"
>
  <div
    class="sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center"
  >
    <div
      class="absolute inset-0 w-full max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-12 gap-4 md:gap-8 items-center z-20 pointer-events-none"
    >
      <div class="col-span-3 md:col-span-3 flex flex-col gap-4 md:gap-6 z-20">
        <div
          class="grid-img-left opacity-0 overflow-hidden rounded-xl md:rounded-2xl shadow-2xl h-24 sm:h-40 md:h-56 border border-white/10 pointer-events-auto"
        >
          <Image
            src="https://picsum.photos/seed/architecture/800/600"
            inferSize
            alt="Grid Image 1"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="grid-img-left opacity-0 overflow-hidden rounded-xl md:rounded-2xl shadow-2xl h-24 sm:h-40 md:h-56 border border-white/10 pointer-events-auto"
        >
          <Image
            src="https://picsum.photos/seed/roadtrip/800/600"
            inferSize
            alt="Grid Image 2"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <div
        id="center-spacer"
        class="col-span-6 md:col-span-6 h-[40vh] sm:h-[50vh] md:h-[65vh]"
      >
      </div>

      <div class="col-span-3 md:col-span-3 flex flex-col gap-4 md:gap-6 z-20">
        <div
          class="grid-img-right opacity-0 overflow-hidden rounded-xl md:rounded-2xl shadow-2xl h-20 sm:h-32 md:h-44 border border-white/10 pointer-events-auto"
        >
          <Image
            src="https://picsum.photos/seed/coastal/800/600"
            inferSize
            alt="Grid Image 3"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="grid-img-right opacity-0 overflow-hidden rounded-xl md:rounded-2xl shadow-2xl h-20 sm:h-32 md:h-44 border border-white/10 pointer-events-auto"
        >
          <Image
            src="https://picsum.photos/seed/forest/800/600"
            inferSize
            alt="Grid Image 4"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>

    <div
      id="reveal-container"
      class="absolute inset-0 flex flex-col justify-end items-start z-30 pointer-events-none px-6 md:px-12 pb-24 md:pb-52 max-w-380 w-full"
    >
      <p
        id="split-target"
        class="opacity-0 translate-y-12 text-2xl md:text-4xl lg:text-7xl font-medium text-left leading-snug text-white drop-shadow-lg"
      >
        The journey doesn't end where the road stops. It begins when you decide
        to keep going.
      </p>
    </div>

    <div
      id="hero-mask"
      class="absolute inset-0 w-full h-full z-10 flex items-center justify-center pointer-events-none"
      style="clip-path: inset(0px 0px 0px 0px round 0px);"
    >
      <div class="relative w-full h-full flex items-center justify-center">
        <Image
          src="https://picsum.photos/seed/nature/1920/1080"
          inferSize
          alt="Main Hero Image"
          class="w-full h-full object-cover"
        />

        <div class="absolute inset-0 bg-black/40 pointer-events-none"></div>

        <div
          id="hero-text"
          class="absolute inset-0 flex flex-col justify-between p-8 md:p-12 lg:p-16 pointer-events-auto text-white"
        >
          <!-- Minimalist, staggered heading utilizing negative space -->
          <div class="w-full mt-12 md:mt-20">
            <h1
              class="flex flex-col -space-y-4 sm:-space-y-6 md:-space-y-8 lg:-space-y-12 text-5xl sm:text-7xl md:text-9xl lg:text-[10rem] font-light tracking-tighter leading-tight"
            >
              <span class="inline-block pb-2">Connecting</span>
              <span class="inline-block pb-2 ml-[10%] md:ml-[15%]"
                >Soils To</span
              >
              <span class="inline-block ml-[20%] md:ml-[30%]">Solutions.</span>
            </h1>
          </div>

          <!-- Bottom section anchoring the corners -->
          <div class="w-full flex justify-between items-end gap-8 pb-4">
            <!-- Scroll indicator pushed to bottom-left -->
            <div
              class="flex items-center gap-3 text-xs uppercase tracking-widest shrink-0"
            >
              <Icon
                name="heroicons:arrow-long-down-20-solid"
                class="animate-bounce size-5"
              />
              <span class="hidden sm:inline">Scroll</span>
            </div>

            <!-- Right-aligned paragraph -->
            <div
              class="max-w-[280px] md:max-w-sm text-right text-sm md:text-base font-light leading-relaxed"
            >
              <p>
                Forging pathways between natural ecosystems and modern
                infrastructure. We build enduring frameworks for a sustainable
                tomorrow.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, SplitText } from "@/utils/gsap-init";

  let ctx: gsap.Context;

  function initHeroAnimation() {
    ctx = gsap.context(() => {
      const spacer = document.querySelector("#center-spacer") as HTMLElement;
      const targetText = document.querySelector("#split-target") as HTMLElement;

      const split = new SplitText(targetText, { type: "words,chars" });

      gsap.set(targetText, { opacity: 0, y: 50 });
      gsap.set(split.chars, { opacity: 0.25 });

      const getDynamicClipPath = () => {
        if (!spacer) return "inset(20% 20% 20% 20% round 24px)";

        const rect = spacer.getBoundingClientRect();
        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;

        const top = rect.top;
        const right = windowWidth - rect.right;
        const bottom = windowHeight - rect.bottom;
        const left = rect.left;

        const radius = windowWidth < 768 ? "16px" : "24px";

        return `inset(${top}px ${right}px ${bottom}px ${left}px round ${radius})`;
      };

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#hero-container",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });

      tl.to(
        "#hero-text",
        {
          opacity: 0,
          y: -50,
          duration: 0.3,
          ease: "power1.out",
        },
        0,
      )
        .to(
          "#hero-mask",
          {
            clipPath: getDynamicClipPath,
            duration: 1.0,
            ease: "power2.inOut",
          },
          0,
        )
        .fromTo(
          ".grid-img-left",
          { x: "-200vw", opacity: 0, rotate: -6 },
          {
            x: "0vw",
            opacity: 1,
            rotate: 0,
            stagger: 0.1,
            duration: 0.85,
            ease: "power2.out",
          },
          0.1,
        )
        .fromTo(
          ".grid-img-right",
          { x: "200vw", opacity: 0, rotate: 6 },
          {
            x: "0vw",
            opacity: 1,
            rotate: 0,
            stagger: 0.1,
            duration: 0.85,
            ease: "power2.out",
          },
          0.1,
        );

      tl.to(
        ".grid-img-left, .grid-img-right, #hero-mask",
        {
          y: "-150vh",
          opacity: 0,
          stagger: 0.05,
          duration: 1.2,
          ease: "power2.inOut",
        },
        "+=0.5",
      )
        .to(
          targetText,
          {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out",
          },
          "<+=0.5",
        )
        .to(
          split.chars,
          {
            opacity: 1,
            stagger: 0.02,
            duration: 0.1,
            ease: "none",
          },
          "-=0.2",
        );
    });
  }

  document.addEventListener("astro:page-load", initHeroAnimation);

  document.addEventListener("astro:before-swap", () => {
    ctx && ctx.revert();
  });
</script>
