---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ImageSlider from "./image-slider.astro";

const caseStudiesEntries = await getCollection("case-studies");

const caseStudies = caseStudiesEntries.map((entry) => ({
  ...entry.data,
  href: `/case-studies/${entry.id}`,
}));
---

<section class="w-full overflow-hidden px-4 mt-16">
  <div class="flex flex-row flex-nowrap items-center justify-between mb-8">
    <div class="space-y-1">
      <h2 class="text-3xl md:text-6xl capitalize tracking-wide">
        Case Studies
      </h2>
      <p
        class="text-sm md:text-base text-black/80 lg:max-w-lg normal-case leading-relaxed"
      >
        Documenting nationwide AgTech adoption, field-level technology
        implementations, and real-world performance benchmarks.
      </p>
    </div>
    <a
      href="/case-studies"
      class="capitalize hover:underline text-sm md:text-base"
    >
      view all ({caseStudies.length})
    </a>
  </div>
  <div class="flex flex-col lg:flex-row items-start gap-8">
    <div class="w-full lg:w-1/3 shrink-0 space-y-8 pr-4">
      <p class="text-base normal-case text-black/60 leading-relaxed">
        Our research lab tracks and analyzes modern agricultural technology
        deployments across the country. Explore detailed case studies evaluating
        how farms and agricultural enterprises are implementing computer vision,
        GIS analytics, and farm mechanization.
      </p>

      <div class="grid grid-cols-2 gap-6 border-t border-black/10 pt-6">
        <div class="space-y-1">
          <p class="text-2xl md:text-4xl font-mono font-medium tracking-tight">
            150+
          </p>
          <p
            class="text-[10px] md:text-xs text-black/60 uppercase tracking-widest font-mono"
          >
            Studies Documented
          </p>
        </div>
        <div class="space-y-1">
          <p class="text-2xl md:text-4xl font-mono font-medium tracking-tight">
            45+
          </p>
          <p
            class="text-[10px] md:text-xs text-black/60 uppercase tracking-widest font-mono"
          >
            Technologies Analyzed
          </p>
        </div>
        <div class="space-y-1">
          <p class="text-2xl md:text-4xl font-mono font-medium tracking-tight">
            12
          </p>
          <p
            class="text-[10px] md:text-xs text-black/60 uppercase tracking-widest font-mono"
          >
            Crop Sectors Covered
          </p>
        </div>
        <div class="space-y-1">
          <p class="text-2xl md:text-4xl font-mono font-medium tracking-tight">
            National
          </p>
          <p
            class="text-[10px] md:text-xs text-black/60 uppercase tracking-widest font-mono"
          >
            Field Reach
          </p>
        </div>
        <a
          href="/case-studies"
          class="group inline-flex items-center gap-3 rounded-full bg-primary py-1.5 pl-5 pr-1.5 text-base text-black w-fit col-span-2"
        >
          <span>Explore All Studies</span>
          <span
            class="flex size-8 items-center justify-center rounded-full bg-white text-black"
          >
            <Icon class="size-5" name="heroicons:arrow-up-right-20-solid" />
          </span>
        </a>
      </div>
    </div>

    <div class="w-full lg:w-2/3">
      <ImageSlider
        images={caseStudies}
        visibleCount={4}
        spanFraction={1}
        dimOnHover
      />
    </div>
  </div>
</section>
