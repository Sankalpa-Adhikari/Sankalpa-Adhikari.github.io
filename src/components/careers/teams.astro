---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const teamEntries = await getCollection("team");

const teamMembers = teamEntries.map((entry) => entry.data);
---

<section class="w-full overflow-hidden px-4 mt-16">
  <div class="flex flex-row flex-nowrap items-center justify-between mb-8">
    <div class="space-y-1">
      <h2 class="text-3xl md:text-6xl capitalize tracking-wide">Our Team</h2>
      <p
        class="text-sm md:text-base text-black/80 lg:max-w-lg normal-case leading-relaxed"
      >
        The brilliant minds behind our research, design, and technical
        processes.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    {
      teamMembers.map((member, index) => (
        <div
          class="group relative w-full cursor-pointer"
          style={`--stagger-index: ${index};`}
        >
          <div class="relative grid grid-cols-1 grid-rows-1 w-full h-150 overflow-hidden rounded-md bg-background/5 transition-transform duration-500 ease-out group-hover:scale-[0.97]">
            <div class="col-start-1 row-start-1 relative w-full h-full overflow-hidden">
              <Image
                src={member.src}
                alt={`${member.firstName} ${member.lastName}`}
                width={600}
                height={1000}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors duration-500" />
            </div>

            <div class="col-start-1 row-start-1 relative z-10 grid grid-cols-1 grid-rows-1 h-full w-full pointer-events-none transition-opacity duration-500 ease-out group-hover:opacity-0">
              <p class="col-start-1 row-start-1 place-self-start text-3xl font-black text-primary uppercase tracking-widest w-full text-center mt-10 px-4 drop-shadow-md">
                {member.firstName}
              </p>

              <div class="col-start-1 row-start-1 place-self-center grid grid-rows-[auto_1fr_auto] items-center justify-items-center p-4 h-full w-full">
                <p class="text-xs sm:text-sm font-semibold text-primary uppercase text-center tracking-widest pt-28 drop-shadow-md">
                  {member.role}
                </p>
                <div class="h-20 sm:h-24" />
                <p class="text-xs sm:text-sm font-semibold text-primary uppercase text-center tracking-widest pb-28 drop-shadow-md">
                  {member.tag}
                </p>
              </div>

              <p class="col-start-1 row-start-1 place-self-end text-3xl font-black text-primary uppercase tracking-widest w-full text-center mb-10 px-4 drop-shadow-md">
                {member.lastName}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
