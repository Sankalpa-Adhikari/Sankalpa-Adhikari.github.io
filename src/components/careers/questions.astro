---
import { Icon } from "astro-icon/components";

const data = [
  {
    title: "WHY?",
    question: "Why join Saptabhume?",
    answers: [
      "Drive real impact by transforming the agricultural value chain and eliminating intermediaries in Nepal.",
      "Work directly with local farming communities to raise their living standards and productivity.",
      "Be part of a mission to institutionalize research and sustainable, modern farming techniques.",
      "Contribute to a holistic, value-driven brand that serves consumers, farmers, and employees impartially.",
    ],
  },
  {
    title: "WHO?",
    question: "Who are we looking for?",
    answers: [
      "Passionate agricultural researchers, agronomists, and rural development enthusiasts.",
      "Result-driven professionals dedicated to exploring the commercial feasibility of the agri-industry.",
      "Innovators eager to modernize farming technologies, processing, and animal production.",
      "Individuals who value quality, equity, ethics, and professional, informed decision-making.",
    ],
  },
  {
    title: "HOW?",
    question: "How do we work?",
    answers: [
      "Hands-on research and practical implementation across our 150-hectare facility in Ramechhap.",
      "Collaborative partnerships with local value chain actors and agricultural stakeholders.",
      "Fostering youth entrepreneurship by disseminating technical know-how directly to producers.",
      "Balancing local traditional knowledge with modern ecosystem innovations and technologies.",
    ],
  },
  {
    title: "WHAT?",
    question: "What do we offer?",
    answers: [
      "Continuous professional development through hands-on fieldwork, consultancy, and training programs.",
      "A robust platform to test, develop, and implement your agricultural research findings.",
      "Leadership opportunities in rural development and agricultural innovation initiatives.",
      "A supportive family of experts committed to environmental sustainability and creating equity.",
    ],
  },
];

const qaStyles = [
  "bg-primary text-black",
  "bg-background text-white",
  "bg-foreground text-black",
];
---

<section class="min-h-screen border-black/20 mt-20 relative">
  {
    data.map((items, index) => {
      const isOdd = index % 2 !== 0;
      const currentStyle = qaStyles[index % qaStyles.length];

      return (
        <div
          style={`z-index: ${index === data.length - 1 ? 90 : index + 1};`}
          class="qa-row relative grid grid-cols-1 lg:grid-cols-2 w-full border-b border-black/20 items-center p-4 bg-white"
        >
          <div
            class={`hidden lg:flex items-center justify-center uppercase font-mono text-[150px] text-center ${
              isOdd ? "rotate-6 lg:order-2" : "-rotate-6 lg:order-1"
            }`}
          >
            {items.title}
          </div>
          <div
            class={`qa-block ${currentStyle} flex flex-col justify-start gap-18 p-6 lg:p-10 rounded-xl min-h-137 lg:min-h-142 ${
              isOdd ? "lg:order-1" : "lg:order-2"
            }`}
          >
            <h3 class="uppercase font-mono text-4xl lg:text-6xl tracking-tight [word-spacing:-0.1em]">
              {items.question}
            </h3>

            <ul class="flex flex-col w-full p-0 list-none divide-y divide-dashed border-y border-dashed border-black/20 divide-black/20">
              {items.answers.map((answer) => (
                <li class="text-[18px] flex items-center gap-4 py-3">
                  <Icon
                    name={"heroicons:check-circle-solid"}
                    class="w-5 h-5 shrink-0"
                  />
                  <span>{answer}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })
  }
</section>

<script>
  import { gsap, ScrollTrigger } from "@/utils/gsap-init";

  let ctx: gsap.Context;

  function initQAAnimation() {
    ctx = gsap.context(() => {
      const cards = gsap.utils.toArray<HTMLElement>(".qa-row");
      const blocks = gsap.utils.toArray<HTMLElement>(".qa-block");

      if (blocks.length > 0) {
        let maxBlockHeight = 0;
        blocks.forEach((block) => {
          maxBlockHeight = Math.max(maxBlockHeight, block.offsetHeight);
        });

        blocks.forEach((block) => {
          gsap.set(block, { minHeight: `${maxBlockHeight}px` });
        });
      }

      cards.forEach((card, index) => {
        if (index < cards.length - 1) {
          ScrollTrigger.create({
            trigger: card,
            start: "top top",
            pin: true,
            pinSpacing: false,
          });
        } else {
          gsap.set(card, { zIndex: 40 });
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initQAAnimation);

  document.addEventListener("astro:before-swap", () => {
    ctx && ctx.revert();
  });
</script>
