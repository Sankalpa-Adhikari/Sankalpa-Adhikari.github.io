---
import "@/styles/global.css";
import { Font } from "astro:assets";
import type { ImageMetadata } from "astro";

import CoreMeta from "@/layout/head/CoreMeta.astro";
import SmoothScroll from "@/layout/head/SmoothScroll.astro";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}
import "@/styles/global.css";
const { title, description, image } = Astro.props;
---

<CoreMeta title={title} description={description} image={image} />
<Font cssVariable="--font-suisse" preload />
<Font cssVariable="--font-sometype" preload />
<SmoothScroll />
