---
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/footer.astro";
import Header from "@/components/header.astro";
import BaseHead from "@/layout/BaseHead.astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  dataPagefindIgnore?: "index" | "all";
}

const { title, description, image, dataPagefindIgnore } = Astro.props;
---

<html lang="en">
  <head>
    <ClientRouter />
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body data-pagefind-ignore={dataPagefindIgnore}>
    <Header />
    <slot />
  </body>
</html>
