---
import { ClientRouter } from "astro:transitions";

import BaseHead from "@/layout/BaseHead.astro";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	dataPagefindIgnore?: "index" | "all";
}

const { title, description, image, dataPagefindIgnore } = Astro.props;
---

<html lang="en">
  <head>
    <ClientRouter />
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body data-pagefind-ignore={dataPagefindIgnore}>
   <Header />
    <slot />
    <Footer />
  </body>
</html>